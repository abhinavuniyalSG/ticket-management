    "morgan": "^1.12.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0",
    "zod": "^4.5.2"
  }
