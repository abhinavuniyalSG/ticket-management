# Copy this file to .env and fill in real values for your machine.
# .env is gitignored at the repo root - never commit real secrets.

# --- Server ---
PORT=3001
NODE_ENV=DEVELOPMENT
LOG_LEVEL=warn

# --- Database (Postgres) ---
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ticket_management_db
DB_PORT=5432
DB_LOGGING=false

# --- Auth (JWT) ---
# Generate long, random values for these, e.g. `openssl rand -hex 32`.
# Never reuse the same secret for both, and never commit real ones.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Password hashing ---
SALT_ROUND=10

# --- Email (SMTP), used for notifications and email verification ---
# SMTP_PASSWORD should be an app-specific password, not your real account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=replace-with-an-app-password
MAIL_FROM=your-email@example.com

# --- App ---
APP_URL=http://localhost:3001
# 24 hours, in milliseconds.
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN_MS=86400000
